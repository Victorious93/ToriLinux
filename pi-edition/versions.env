# VictorLinux Raspberry Pi edition: pinned BUILD-time inputs. Nothing here is fetched at runtime.
# The Debian suite, mirrors and llama.cpp pin come from ../debian-edition/versions.env (sourced first by build.sh),
# so both editions always build the same llama.cpp commit.
PI_ARCH=arm64
# Raspberry Pi firmware, kernels, Bluetooth/Wi-Fi firmware: Raspberry Pi Ltd's apt archive (build time only).
RPI_ARCHIVE=https://archive.raspberrypi.com/debian
RPI_SUITE=trixie
RPI_COMPONENT=main
# Archive signing key shipped in keys/raspberrypi-archive.asc; build.sh refuses to run if the fingerprint differs.
RPI_KEY_FPR=CF8A1AF502A2AA2D763BAE7E82B129927FA3303E
# Image layout (MiB). The data partition (label VICTORDATA) grows to fill the card on first boot.
PI_BOOT_MIB=512
PI_DATA_MIB=256
PI_IMAGE_NAME=VictorLinux-pi
