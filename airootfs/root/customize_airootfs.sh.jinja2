#!/bin/bash
# Image customization, run by mkarchiso inside the image chroot (build time only).
# Original: ToriLinux (sasha0552, MIT). Reworked by Victorious / Victorious Framework.
set -euo pipefail

export CUSTOMIZE_AIROOTFS=/root/customize_airootfs
export HOME=/home/tori
export PATH=$HOME/.local/bin:$PATH

# The 'tori' account has NO password (locked in /etc/shadow). The physical console auto-logs in;
# network logins are impossible until the owner adds an SSH key (see tori-priv / Control Center).
# Nothing here may set a shared password.
passwd -l tori >/dev/null
passwd -l root >/dev/null

find /root -type f -name "*.jinja2" -print -delete

# user and runtime dirs with correct ownership
install -d -o tori -g tori -m 700 /home/tori /home/tori/.cache/tori
chown -R tori:tori /home/tori

systemctl disable sshd.service 2>/dev/null || true
systemctl mask sshd.socket 2>/dev/null || true
systemctl enable tori-boot-setup.service
systemctl enable systemd-networkd.service

{% if platform == "cuda" %}
wget "{{ gh_release("nvidia_pstated") }}" -O "/usr/local/bin/nvidia-pstated"
chmod +x "/usr/local/bin/nvidia-pstated"
systemctl enable nvidia-persistenced
systemctl enable nvidia-pstated.service
{% endif %}

{% if type != "empty" %}
# llama.cpp backends (root, build time)
for script in "$CUSTOMIZE_AIROOTFS"/root-scripts/*.sh; do
  echo "===> Executing root script $script"
  bash "$script"
done
rm -rf /root/sources

# optional packs (as the unprivileged user)
su tori -c "pipx install transient-package" || true
cd /home/tori
for script in "$CUSTOMIZE_AIROOTFS"/scripts/*.sh; do
  echo "===> Executing script $script"
  chmod +x "$script"
  su tori -c "$script"
  {% if "hip" in packs or platform == "amd" %}
  rdfind -checksum sha256 -makehardlinks true -makeresultsfile false "." >/dev/null
  {% endif %}
done
{% endif %}

# release stamp shown in diagnostics
cat > /etc/tori-release <<REL
Tori Linux (Victorious fork)
platform={{ platform }} type={{ type }} packs={{ packs|join(",") or "none" }}
arch_snapshot={{ build.arch_snapshot }}
$(cat /opt/llama.cpp/BUILDINFO 2>/dev/null || echo "llama.cpp: not included")
REL

rm -fr "$CUSTOMIZE_AIROOTFS"
