#!/bin/bash
set -eu
{% if "comfyui" in packs %}
# EXPERIMENTAL pack: not build-verified in the Victorious fork yet.
git clone "{{ repositories.comfyui }}.git"
pushd "ComfyUI"
  git checkout "{{ revisions.comfyui }}"
  git checkout -b tori
  python3 -m venv venv
  source venv/bin/activate
    {% if platform == "amd" %}
    # PyTorch ROCm wheels (build-time download). The index is taken from ComfyUI's own README.
    index_url=$(grep -o 'https://download.pytorch.org/whl/rocm[0-9.]*' README.md | head -n1)
    pip3 install torch torchvision torchaudio --index-url "$index_url"
    {% endif %}
    pip3 install -r requirements.txt
  deactivate
popd
{% endif %}
