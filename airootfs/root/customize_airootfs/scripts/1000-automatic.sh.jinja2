#!/bin/bash
set -eu
{% if "automatic" in packs %}
# EXPERIMENTAL pack (SD.Next): revision unchanged from upstream ToriLinux, not re-verified.
git clone "{{ repositories.automatic }}.git"
pushd "automatic"
  git checkout "{{ revisions.automatic }}"
  git checkout -b victor
  git submodule update --init --recursive
  python3 -m venv venv
  source venv/bin/activate
    python3 launch.py --test
  deactivate
popd
{% endif %}
