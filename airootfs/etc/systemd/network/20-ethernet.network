[Match]
# Matching with "Type=ether" causes issues with containers because it also matches virtual Ethernet interfaces (veth*).
# See https://bugs.archlinux.org/task/70892
Name=en*
Name=eth*

[Network]
DHCP=yes
# mDNS responder disabled: nothing on this machine should advertise itself on the LAN unprompted.
MulticastDNS=no
LLMNR=no

[DHCPv4]
# DHCP failure/absence must never delay boot or the offline experience.
RouteMetric=100
