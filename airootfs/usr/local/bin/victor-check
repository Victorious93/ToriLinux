#!/usr/bin/env python3
"""Check this PC: GPU driver, /dev/dri access, Vulkan, backend, storage, with concrete fixes. --json for machine output."""
import json
import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "victorlinux"))
import control_center as cc  # noqa: E402
import pccheck  # noqa: E402
import victorcommon as tc  # noqa: E402

facts = cc.collect_pc_facts()
report = pccheck.evaluate(facts)
saved = None
if "--no-save" not in sys.argv and tc.data_path("reports"):
    saved = pccheck.save_profile(tc.data_path("reports"), facts, report)
if "--json" in sys.argv:
    print(json.dumps({"report": report, "facts": facts, "saved": saved}, indent=2))
else:
    print(pccheck.as_text(report))
    if saved:
        print(f"\nSaved: {saved['report']}")
sys.exit(0 if report["summary"]["verdict"] != "bad" else 1)
