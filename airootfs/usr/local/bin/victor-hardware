#!/usr/bin/env python3
"""Print this PC's measured hardware and estimated offline model recommendations."""
import json
import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "victorlinux"))
import victorcommon as tc
import model_advisor

gpus = tc.gpus()
backend, reason = tc.choose_backend("auto", gpus)
result = model_advisor.report(tc.ram_info(), gpus, backend, tc.load_settings()["ctx"])
result["backend_reason"] = reason
print(json.dumps(result, indent=2))
