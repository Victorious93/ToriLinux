#!/bin/bash
# Create a self-signed TLS certificate for the inference gateway.
# usage: tori-tls-cert HOSTNAME_OR_IP
set -eu
host="${1:?usage: tori-tls-cert HOSTNAME_OR_IP}"
case "$host" in *[!A-Za-z0-9.:-]*) echo "invalid host" >&2; exit 2;; esac
root="$(python3 -I -c 'import sys; sys.path.insert(0,"/usr/local/lib/tori"); import toricommon as t; print(t.data_root() or "")')"
[ -n "$root" ] || { echo "No storage selected" >&2; exit 1; }
dir="$root/server/tls"
mkdir -p "$dir"; chmod 700 "$dir"
if [[ "$host" =~ ^[0-9.:]+$ ]]; then san="IP:$host"; else san="DNS:$host"; fi
openssl req -x509 -newkey rsa:3072 -sha256 -days 825 -nodes \
  -keyout "$dir/key.pem" -out "$dir/cert.pem" -subj "/CN=$host" -addext "subjectAltName=$san" 2>/dev/null
chmod 600 "$dir/key.pem"
echo "Certificate written to $dir/cert.pem"
openssl x509 -in "$dir/cert.pem" -noout -fingerprint -sha256
echo "Self-signed: import cert.pem into the client's trust store, or use a VPN (Tailscale) / reverse proxy with a real certificate."
