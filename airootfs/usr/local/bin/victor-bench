#!/bin/bash
# Benchmark the selected model with llama-bench on a chosen backend; output is saved to the data partition.
# usage: victor-bench [backend] [model.gguf]
set -eu
backend="${1:-vulkan}"
model="${2:-$(python3 -I -c 'import sys; sys.path.insert(0,"/usr/local/lib/victorlinux"); import victorcommon as t; print(t.load_settings().get("model",""))')}"
bin="/opt/llama.cpp/$backend/bin/llama-bench"
[ -x "$bin" ] || { echo "backend '$backend' not present in this image" >&2; exit 1; }
[ -f "$model" ] || { echo "no model: pass a .gguf path" >&2; exit 1; }
root="$(python3 -I -c 'import sys; sys.path.insert(0,"/usr/local/lib/victorlinux"); import victorcommon as t; print(t.data_root() or "/tmp")')"
out="$root/logs/bench-$backend-$(date +%Y%m%d-%H%M%S).txt"
mkdir -p "$root/logs"
{ echo "# victor-bench backend=$backend model=$model"; victor-diag | head -20; "$bin" -m "$model" -ngl 999 -p 512 -n 128 -r 3; } 2>&1 | tee "$out"
echo "saved: $out"
