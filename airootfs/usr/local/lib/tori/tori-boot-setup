#!/bin/bash
# Boot-time storage discovery. USB media can enumerate slowly, so retry briefly before concluding "missing".
# Never formats or modifies partitions; never falls back to temporary mode on its own.
set -u
priv=/usr/local/lib/tori/tori-priv
install -d -m 755 /run/tori
udevadm settle --timeout=20 2>/dev/null || true
for _ in $(seq 1 10); do
  out=$("$priv" persist-auto 2>&1) || out="error"
  case "$out" in
    missing) sleep 2 ;;
    *) break ;;
  esac
done
echo "tori-boot-setup: storage result: $out"
exit 0
