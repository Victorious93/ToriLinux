#!/usr/bin/env python3
"""victor-ctl: single CLI behind the VictorLinux Control Center (the GUI only calls this)."""
import argparse, json, os, sys
sys.path.insert(0, "/usr/local/lib/victorlinux")
from victorlib.common import *
from victorlib import hw, storage, models, llama, api, bench, kali, diag

PRIV = ["sudo", "-n", "/usr/local/lib/victorlinux/victor-priv"]


def priv(*args):
    r = run([*PRIV, *args], timeout=300)
    if r.returncode != 0:
        raise VictorError((r.stderr or r.stdout).strip() or f"privileged helper failed ({r.returncode})")
    return r.stdout.strip()


def out(a, obj):
    if getattr(a, "json", False) or not isinstance(obj, str):
        print(json.dumps(obj, indent=2, default=str))
    else:
        print(obj)


def main():
    ap = argparse.ArgumentParser(prog="victor-ctl")
    ap.add_argument("--json", action="store_true")
    sp = ap.add_subparsers(dest="grp", required=True)
    def g(name, *subs):
        p = sp.add_parser(name); s = p.add_subparsers(dest="cmd", required=True)
        r = {}
        for n in subs:
            r[n] = s.add_parser(n)
        return r
    st = g("storage", "status", "list", "select", "session", "check", "repair", "init")
    st["select"].add_argument("uuid")
    hwp = g("hw", "snapshot", "backend")
    mo = g("model", "list", "import", "inspect", "select", "remove")
    mo["import"].add_argument("src"); mo["import"].add_argument("--sha256"); mo["import"].add_argument("--move", action="store_true")
    mo["inspect"].add_argument("path"); mo["select"].add_argument("name"); mo["remove"].add_argument("name")
    ll = g("llama", "start", "stop", "status", "config")
    ll["config"].add_argument("--set", nargs="*", default=[], metavar="KEY=VALUE")
    ap_ = g("api", "connection", "capabilities", "selftest", "rotate-key")
    ap_["connection"].add_argument("--reveal-key", action="store_true"); ap_["selftest"].add_argument("--tools", action="store_true")
    g("bench", "run")
    ka = g("kali", "status", "start", "stop", "download", "load-pack")
    ka["start"].add_argument("--cap", action="append", default=[]); ka["download"].add_argument("--yes", action="store_true")
    ka["load-pack"].add_argument("tar")
    g("diag", "show", "save-log")
    g("versions", "show")
    a = ap.parse_args()
    try:
        if a.grp == "storage":
            if a.cmd in ("status", "list"):
                out(a, storage.status() if a.cmd == "status" else storage.list_candidates())
            elif a.cmd == "select":
                out(a, priv("storage-mount", a.uuid))
            elif a.cmd == "session":
                out(a, priv("storage-session"))
            elif a.cmd in ("check", "repair"):
                out(a, priv("storage-" + a.cmd))
            elif a.cmd == "init":
                storage.ensure_layout(root_dir()); out(a, "layout ready")
        elif a.grp == "hw":
            if a.cmd == "snapshot":
                out(a, hw.snapshot())
            else:
                c = llama.load_config(); d = hw.llama_devices()
                out(a, hw.select_backend(c["backend"], d["devices"], None))
        elif a.grp == "model":
            if a.cmd == "list": out(a, models.list_models())
            elif a.cmd == "import": out(a, models.import_model(a.src, a.sha256, a.move, llama.load_config()["ctx"]))
            elif a.cmd == "inspect":
                i = models.inspect_gguf(a.path); i["estimate"] = models.estimate(i["size"]); out(a, i)
            elif a.cmd == "select":
                c = llama.load_config()
                if not os.path.isfile(os.path.join(data_path("models"), a.name)): raise VictorError("no such model")
                c["model"] = a.name; llama.save_config(c); out(a, f"selected {a.name}")
            elif a.cmd == "remove":
                if llama.is_running(): raise VictorError("Stop the service before removing models.")
                os.unlink(os.path.join(data_path("models"), a.name)); out(a, "removed")
        elif a.grp == "llama":
            if a.cmd == "start": out(a, llama.start())
            elif a.cmd == "stop": out(a, llama.stop())
            elif a.cmd == "status": out(a, llama.status())
            else:
                c = llama.load_config(); old = json.loads(json.dumps(c))
                for kv in a.set:
                    k, v = kv.split("=", 1); path = k.split(".")
                    t = c
                    for p_ in path[:-1]: t = t[p_]
                    old = t[path[-1]]
                    t[path[-1]] = (v.lower() in ("1", "true", "yes", "on")) if isinstance(old, bool) else type(old)(v)
                if a.set:
                    llama.save_config(c)          # validates (bind/TLS/remote policy) before anything privileged happens
                    was, now = old["remote"]["enabled"], c["remote"]["enabled"]
                    if was and (not now or old["port"] != c["port"] or old["bind"] != c["bind"]):
                        priv("fw-sync", str(old["port"]), old["bind"], "0")
                    if now and (not was or old["port"] != c["port"] or old["bind"] != c["bind"]):
                        priv("fw-sync", str(c["port"]), c["bind"], "1")
                out(a, c)
        elif a.grp == "api":
            if a.cmd == "connection": out(a, api.connection_info(a.reveal_key))
            elif a.cmd == "capabilities": out(a, api.capabilities())
            elif a.cmd == "selftest": out(a, api.selftest(a.tools))
            else: llama.ensure_key(rotate=True); out(a, "API key rotated; restart the service and update clients")
        elif a.grp == "bench": out(a, bench.run_bench())
        elif a.grp == "kali":
            if a.cmd == "status": out(a, kali.status())
            elif a.cmd == "start": out(a, kali.start(caps=tuple(a.cap)))
            elif a.cmd == "stop": out(a, kali.stop())
            elif a.cmd == "download": out(a, kali.download_pack(a.yes))
            else: out(a, kali.load_pack(a.tar))
        elif a.grp == "diag":
            out(a, diag.collect() if a.cmd == "show" else diag.save_log_snapshot())
        elif a.grp == "versions":
            out(a, diag.collect()["image_facts"] | diag.collect()["llama_build"])
    except VictorError as e:
        print(f"ERROR: {e}", file=sys.stderr); sys.exit(2)


if __name__ == "__main__":
    main()
