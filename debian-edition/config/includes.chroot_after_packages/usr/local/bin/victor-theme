#!/bin/bash
# VictorLinux has one appearance: dark. Old per-drive light preferences are ignored.
set -Eeuo pipefail
case "${1:-status}" in
  status) echo dark; exit 0;;
  dark|apply) ;;
  *) echo "VictorLinux always uses dark mode. Usage: victor-theme dark|apply|status" >&2; exit 2;;
esac
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$cfg/victorlinux"
printf 'dark\n' > "$cfg/victorlinux/theme"
python3 - "$cfg" <<'PYTHEME'
import configparser, json, os, sys
from pathlib import Path
cfg = Path(sys.argv[1])
for version in ('gtk-3.0', 'gtk-4.0'):
    p = cfg / version / 'settings.ini'
    c = configparser.ConfigParser(); c.optionxform = str
    c.read(p)
    if not c.has_section('Settings'): c.add_section('Settings')
    c['Settings'].update({'gtk-theme-name': 'Adwaita-dark', 'gtk-application-prefer-dark-theme': 'true'})
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('w') as f: c.write(f, space_around_delimiters=False)
p = cfg / 'xfce4/terminal/terminalrc'
c = configparser.ConfigParser(); c.optionxform = str; c.read(p)
if not c.has_section('Configuration'): c.add_section('Configuration')
# VictorLinux brand palette: #0B0F1A background, cyan #00E5FF cursor/selection, magenta #FF2BD6 in the ANSI palette.
c['Configuration'].update({'ColorForeground': '#e8eef9', 'ColorBackground': '#0b0f1a', 'ColorCursor': '#00e5ff',
                           'ColorPalette': '#1d2740;#ff6b88;#3ee6a8;#ffc857;#5b8cff;#ff2bd6;#00e5ff;#e8eef9;#5a6a8f;#ff8fa6;#7af0c4;#ffd98a;#8fb0ff;#ff70e4;#6af0ff;#f5f8ff'})
p.parent.mkdir(parents=True, exist_ok=True)
with p.open('w') as f: c.write(f, space_around_delimiters=False)
# Best effort: persistence may be missing or read-only. Preserve unrelated settings.
p = Path(os.environ.get('VICTOR_RUN', '/run/victor')) / 'root/settings/ui.json'
try:
    data = json.loads(p.read_text()) if p.exists() else {}
    if not isinstance(data, dict): data = {}
    data['theme'] = 'dark'
    tmp = p.with_suffix('.tmp')
    tmp.write_text(json.dumps(data) + '\n'); tmp.replace(p)
except (OSError, ValueError): pass
PYTHEME
if command -v xfconf-query >/dev/null && [ -n "${DISPLAY:-}" ]; then
  xfconf-query -c xsettings -p /Net/ThemeName -s Adwaita-dark 2>/dev/null || \
    xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s Adwaita-dark 2>/dev/null || true
fi
echo dark
