#!/bin/bash
# Open the local llama.cpp chat UI in a DEDICATED browser profile stored on the data partition (chat history persists there).
set -Eeuo pipefail
rt=/run/victor/llama.runtime.json
if ! systemctl --user is-active --quiet victor-llama; then
  msg="The inference service is not running. Open Control Center > Status > Start inference."
  python3 -c "import tkinter,tkinter.messagebox as m; tkinter.Tk().withdraw(); m.showinfo('Local AI Chat', '$msg')" 2>/dev/null || echo "$msg" >&2
  exit 1
fi
port=$(python3 -c "import json;print(json.load(open('$rt'))['port'])")
scheme=http; [ "$(python3 -c "import json;print(json.load(open('$rt'))['tls'])")" = True ] && scheme=https
prof=/run/victor/root/chat/firefox-profile
mkdir -p "$prof"
# Force browser chrome and content dark even if an old profile preferred light.
cat > "$prof/user.js" <<'PREFS'
user_pref("layout.css.prefers-color-scheme.content-override", 0);
user_pref("browser.theme.toolbar-theme", 0);
user_pref("browser.theme.content-theme", 0);
PREFS
exec firefox-esr --no-remote --profile "$prof" "${scheme}://127.0.0.1:${port}/"
